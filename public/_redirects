# Article URLs moved from /blog/<slug>/ to /<slug>/, and /lab/ is gone.
# Netlify reads this from the publish root; Cloudflare Pages accepts it too.
# A rule only fires when no file exists at the source path, which is the case
# for every route below.
/blog             /            301
/blog/            /            301
/blog/*           /:splat      301
/lab              /            301
/lab/             /            301
/lab/*            /            301
/page/*           /            301
