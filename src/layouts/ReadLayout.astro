---
import '../styles/site.css';
import '../styles/read-views.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

type Props = {
  title: string;
  description?: string;
  /** Layout personality: the quiet editorial view, or the man pages. */
  view?: 'read' | 'man';
  section?: 'read' | 'man' | 'shell';
};

const { title, description = '', view = 'read', section = 'read' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
  </head>
  <body class={`view-${view}`}>
    <SiteHeader section={section} />
    <main class="frame">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
