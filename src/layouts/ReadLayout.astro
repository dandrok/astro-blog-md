---
import '../styles/read-views.css';

type Props = {
  title: string;
  description?: string;
  view?: 'read' | 'man';
  current?: 'index' | 'article';
};

const { title, description = '', view = 'read', current = 'index' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
  </head>
  <body class={`view-${view}`}>
    {
      view === 'read' && (
        <div class="topbar">
          <a class="home" href="/lab/read/">
            ~/.file
          </a>
          <nav aria-label="Reading views">
            <a href="/lab/read/" aria-current={current === 'index' ? 'page' : undefined}>
              index
            </a>
            <a href="/lab/man/">man</a>
            <a href="/lab/">shell</a>
          </nav>
        </div>
      )
    }

    <main><slot /></main>

    <footer class="site">
      <div><span style="color: var(--dim-2)">$</span> cat ~/.file/links</div>
      <div class="links">
        <a href="https://github.com/dandrok">github</a>
        <a href="/rss.xml">rss</a>
        <a href="/blog/">blog</a>
        <a href="/lab/">shell</a>
      </div>
    </footer>
  </body>
</html>
