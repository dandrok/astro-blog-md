---
import '../styles/site.css';
import '../styles/article.css';
import SiteHead from '../components/site/SiteHead.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ThemeStyles from '../components/site/ThemeStyles.astro';

type Props = { title?: string; description?: string };

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} />
    <ThemeStyles />
  </head>
  <body class="view-article">
    <SiteHeader />
    <main class="frame">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { followTheme, renderMermaidDiagrams } from '../lib/mermaid';

      // The only script an article page needs: mermaid itself is a lazy chunk,
      // so pages without a diagram never fetch it.
      renderMermaidDiagrams()
        .then(() => followTheme())
        .catch((error) => console.error('mermaid: setup failed', error));
    </script>
  </body>
</html>
