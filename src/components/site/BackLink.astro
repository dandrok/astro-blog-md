---
// The same control sits above and below an article, so it is one component:
// one label, one size, one hover state, in both places.
type Props = { href?: string; label?: string };

const { href = '/#writing', label = '← all articles' } = Astro.props;
---

<a class="back" href={href}>{label}</a>

<style>
  .back {
    display: inline-block;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    text-decoration: none;
  }
  .back:hover,
  .back:focus-visible {
    color: var(--accent);
  }
</style>
