---
// Every navigation link inside an article — `← all articles` above and below,
// and the way back into the shell — so they cannot drift apart: one size, one
// colour, one hover, lowercase.
type Props = { href: string; label: string };

const { href, label } = Astro.props;
---

<a class="arrow-link" href={href}>{label}</a>

<style>
  .arrow-link {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--dim);
    text-decoration: none;
  }
  .arrow-link:hover,
  .arrow-link:focus-visible {
    color: var(--accent);
  }
</style>
