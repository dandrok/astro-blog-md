---
import { render } from 'astro:content';
import ReadLayout from '../../../layouts/ReadLayout.astro';
import { readPosts, longDate } from '../../../lib/read';
import type { ReadPost } from '../../../lib/read';

export async function getStaticPaths() {
  const posts = await readPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: ReadPost };
const { Content, headings } = await render(post.entry);
const name = post.slug.toUpperCase();
const tags = post.entry.data.tags ?? [];
---

<ReadLayout
  view="man"
  title={`${name}(7) — ~/.file`}
  description={post.entry.data.description ?? ''}
>
  <div class="man-head">
    <span>{name}(7)</span>
    <span>~/.file</span>
    <span>{name}(7)</span>
  </div>

  <div class="man-title">
    <h1>{post.entry.data.title}</h1>
    <p>{longDate(post.entry.data.pubDate)} · {post.readingMinutes} min · {post.words} words</p>
  </div>

  <section class="man-section">
    <h2>name</h2>
    <div class="man-body">
      <p>{post.slug} — {post.entry.data.description}</p>
    </div>
  </section>

  <section class="man-section">
    <h2>synopsis</h2>
    <div class="man-body">
      <p class="synopsis">cat <span>~/writing/</span>{post.slug}.md{tags.length > 0 && <span> — tags: {tags.join(', ')}</span>}</p>
    </div>
  </section>

  <section class="man-section">
    <h2>description</h2>
    <div class="man-body prose">
      <Content />
    </div>
  </section>

  {
    headings.filter((heading) => heading.depth === 2).length > 0 && (
      <section class="man-section">
        <h2>sections</h2>
        <div class="man-body">
          <p>
            {headings
              .filter((heading) => heading.depth === 2)
              .map((heading, index, list) => (
                <>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                  {index < list.length - 1 && ', '}
                </>
              ))}
          </p>
        </div>
      </section>
    )
  }

  <section class="man-section">
    <h2>see also</h2>
    <div class="man-body">
      <p><a href="/lab/man/">apropos(1)</a>, <a href="/lab/read/">index(1)</a>, <a href="/lab/">dotfile-shell(1)</a></p>
    </div>
  </section>

  <div class="man-foot">
    <span>dotfile 1.0</span>
    <span>{post.words} words</span>
    <span>{name}(7)</span>
  </div>
</ReadLayout>
