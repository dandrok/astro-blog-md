---
// /lab — the terminal site: a centred terminal window running a real shell
// over a virtual filesystem generated from the content collection.
import { getCollection } from 'astro:content';
import { slugify, type PostSeed } from '../lib/terminal';

const posts: PostSeed[] = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    slug: slugify(post.id),
    title: post.data.title,
    description: post.data.description ?? '',
    date: post.data.pubDate.toISOString().slice(0, 10),
    tags: post.data.tags ?? [],
    body: (post as { body?: string }).body ?? '',
  }));

const enriched = posts.map((post) => ({
  ...post,
  day: new Date(post.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }),
  year: post.date.slice(0, 4),
  minutes: Math.max(1, Math.round(post.body.split(/\s+/).filter(Boolean).length / 220)),
}));

const yearGroups = [...new Set(enriched.map((post) => post.year))]
  .sort((a, b) => b.localeCompare(a))
  .map((year) => ({ year, posts: enriched.filter((post) => post.year === year) }));

const data = JSON.stringify(posts).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>~/.file — terminal</title>
    <meta name="description" content="A personal site that behaves like a Unix home directory: a working shell, a virtual filesystem and the articles as files you can read and edit." />
    <style is:global>
      :root {
        --bg: #030804;
        --frame: rgba(0, 255, 65, 0.3);
        --text: #a3f2b0;
        --dim: #2f7a3d;
        --accent: #00ff41;
      }
      * { box-sizing: border-box; }
      html { margin: 0; background: var(--bg); }
      body { margin: 0; min-height: 100%; }
      body {
        background:
          radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--bg) 60%, #0b1a0d) 0%, var(--bg) 60%, color-mix(in srgb, var(--bg) 85%, #000) 100%);
        color: var(--text);
        font-family: ui-monospace, 'JetBrains Mono', 'SFMono-Regular', Menlo, monospace;
        overflow-x: hidden;
      }
      .hero {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0;
        width: 100%;
        padding: clamp(10px, 3vh, 40px) clamp(10px, 3vw, 32px) 26px;
      }
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px);
        opacity: 0;
        transition: opacity 160ms ease;
      }
      body[data-scanlines='on']::after { opacity: 1; }
      .shell {
        position: relative;
        width: 100%;
        max-width: 1120px;
        height: min(78vh, 720px);
        display: flex;
        flex-direction: column;
        border: 1px solid var(--frame);
        border-radius: 8px;
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        box-shadow:
          0 0 0 1px color-mix(in srgb, var(--frame) 40%, transparent),
          0 30px 90px -24px color-mix(in srgb, var(--accent) 22%, transparent),
          inset 0 1px 0 color-mix(in srgb, var(--accent) 12%, transparent);
        overflow: hidden;
      }
      .titlebar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 14px;
        border-bottom: 1px solid color-mix(in srgb, var(--frame) 70%, transparent);
        background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent);
        font-size: 12px;
        letter-spacing: 0.06em;
        color: var(--dim);
        user-select: none;
      }
      .dots { display: flex; gap: 7px; }
      .dot { width: 10px; height: 10px; border-radius: 50%; opacity: 0.85; }
      .dot.r { background: #ff5f57; }
      .dot.y { background: #febc2e; }
      .dot.g { background: #28c840; }
      .titlebar .name { flex: 1; text-align: center; color: var(--text); opacity: 0.8; }
      .titlebar .stat { color: var(--dim); font-variant-numeric: tabular-nums; }
      #term { flex: 1; min-height: 0; padding: 8px 10px 4px; }
      #term .xterm { height: 100%; }
      .hint {
        margin: 12px auto 0;
        max-width: 1120px;
        font-size: 11.5px;
        letter-spacing: 0.05em;
        color: var(--dim);
        text-align: center;
        display: flex;
        gap: 18px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .hint kbd {
        border: 1px solid color-mix(in srgb, var(--frame) 80%, transparent);
        border-bottom-width: 2px;
        border-radius: 3px;
        padding: 1px 5px;
        font: inherit;
        color: var(--text);
      }
      .hint code { color: var(--text); }
      .hint a { color: var(--text); text-decoration: none; border-bottom: 1px dashed currentColor; }

      /* editor overlay */
      .editor-layer { position: absolute; inset: 0; display: none; flex-direction: column; background: color-mix(in srgb, var(--bg) 97%, #000); z-index: 5; }
      .editor-layer.on { display: flex; }
      .editor-bar {
        display: flex; justify-content: space-between; gap: 12px; align-items: center;
        padding: 8px 14px; font-size: 12px; letter-spacing: 0.06em;
        border-bottom: 1px solid color-mix(in srgb, var(--frame) 90%, transparent);
        color: var(--accent);
        background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 9%, transparent), transparent);
      }
      .editor-bar .path { color: var(--text); }
      .editor-bar .flag { color: var(--dim); }
      #editor { flex: 1; min-height: 0; overflow: auto; }
      #editor .cm-editor { height: 100%; background: transparent; }
      #editor .cm-scroller { font-family: ui-monospace, 'JetBrains Mono', Menlo, monospace; font-size: 14px; line-height: 1.5; }
      #editor .cm-gutters { background: transparent; border-right: 1px solid color-mix(in srgb, var(--frame) 40%, transparent); color: var(--dim); }
      .cm-vim-panel, .cm-vim-panel input { color: var(--accent) !important; background: transparent !important; font-family: inherit !important; }
      .editor-foot {
        display: flex; justify-content: space-between; gap: 12px;
        padding: 6px 14px; font-size: 11.5px; color: var(--dim);
        border-top: 1px solid color-mix(in srgb, var(--frame) 50%, transparent);
      }
      .editor-foot .save { color: var(--accent); }

      .titlebar .door {
        color: var(--dim);
        border: 0;
        font-size: 11.5px;
        letter-spacing: 0.08em;
        padding: 2px 8px;
        border: 1px solid color-mix(in srgb, var(--frame) 70%, transparent);
        border-radius: 3px;
        transition: color 120ms ease, border-color 120ms ease;
      }
      .titlebar .door:hover { color: var(--accent); border-color: var(--accent); }

      /* starter chips: the beginner path, inside the window frame */
      .suggest {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 10px;
        padding: 9px 12px;
        border-top: 1px solid color-mix(in srgb, var(--frame) 60%, transparent);
        background: linear-gradient(0deg, color-mix(in srgb, var(--accent) 6%, transparent), transparent);
        font-size: 12px;
        color: var(--dim);
      }
      .suggest .lead {
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-size: 10.5px;
        color: color-mix(in srgb, var(--dim) 80%, transparent);
        margin-right: 2px;
      }
      .suggest button,
      .suggest a {
        font: inherit;
        font-size: 12px;
        color: var(--text);
        background: transparent;
        border: 1px solid color-mix(in srgb, var(--frame) 55%, transparent);
        border-radius: 3px;
        padding: 3px 9px;
        cursor: pointer;
        text-decoration: none;
        transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
      }
      .suggest button:hover,
      .suggest a:hover {
        color: var(--bg);
        background: var(--accent);
        border-color: var(--accent);
      }
      .suggest .dismiss {
        margin-left: auto;
        border-color: transparent;
        color: color-mix(in srgb, var(--dim) 70%, transparent);
        font-size: 11px;
      }
      .suggest .dismiss:hover { background: transparent; color: var(--text); }
      .suggest[hidden] { display: none; }

      /* the reading section the hero scrolls into */
      .reading {
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 clamp(14px, 4vw, 32px) 96px;
      }
      .reading .section-title {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        border-top: 1px solid color-mix(in srgb, var(--frame) 70%, transparent);
        padding-top: 14px;
        margin-bottom: 4px;
        font-size: 11.5px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .reading .section-title a { color: var(--text); border: 0; }
      .reading .section-title a:hover { color: var(--accent); }
      .reading .year {
        margin: 26px 0 2px;
        font-size: 11px;
        letter-spacing: 0.24em;
        color: color-mix(in srgb, var(--dim) 75%, transparent);
      }
      .reading .row {
        display: grid;
        grid-template-columns: 6.5ch minmax(0, 1fr);
        gap: 3px 18px;
        padding: 13px 0;
        border-bottom: 1px solid color-mix(in srgb, var(--frame) 45%, transparent);
      }
      .reading a { color: inherit; text-decoration: none; }
      .reading .row:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
      .reading .row:hover .title { color: #fff; }
      .reading .date { color: var(--dim); font-size: 12.5px; font-variant-numeric: tabular-nums; }
      .reading .row-main { min-width: 0; }
      .reading .row .title { color: var(--text); font-size: 15.5px; }
      .reading .row:hover a.title { color: #fff; }
      .reading .row .meta { display: block; margin-top: 2px; font-size: 11.5px; color: color-mix(in srgb, var(--dim) 80%, transparent); }
      .reading .row .desc {
        margin: 4px 0 0;
        font-size: 12.5px;
        color: var(--dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .scroll-cue {
        display: flex;
        justify-content: center;
        padding: 0 0 26px;
        font-size: 11.5px;
        letter-spacing: 0.16em;
        color: color-mix(in srgb, var(--dim) 80%, transparent);
      }
      .scroll-cue a { color: inherit; border: 0; }
      .scroll-cue a:hover { color: var(--accent); }

      @media (max-width: 680px) {
        .hero { padding: 0; min-height: 0; }
        .shell { height: 100dvh; max-width: none; border: 0; border-radius: 0; }
        .hint, .scroll-cue { display: none; }
        #term { padding: 6px; }
        .suggest { padding: 8px 10px; gap: 6px; }
        .suggest button, .suggest a { font-size: 11.5px; padding: 3px 7px; }
      }
      @media (prefers-reduced-motion: reduce) {
        body::after { display: none; }
      }
    </style>
  </head>
  <body>
    <main class="hero">
      <div class="shell" id="shell">
        <div class="titlebar">
          <div class="dots" aria-hidden="true"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></div>
          <span class="name" id="win-title">dandrok@dotfile: ~</span>
          <a class="door" href="/lab/read/">read →</a>
          <span class="stat" id="win-size">—</span>
        </div>
        <div id="term" role="application" aria-label="interactive terminal"></div>
        <div class="suggest" id="suggest">
          <span class="lead">start here</span>
          <button type="button" data-run="ls ~/writing">ls ~/writing</button>
          <button type="button" data-run="cat about.md">cat about.md</button>
          <button type="button" data-run="help">help</button>
          <a href="#reading">read the posts ↓</a>
          <button type="button" class="dismiss" id="suggest-hide">hide hints</button>
        </div>

        <div class="editor-layer" id="editor-layer" aria-hidden="true">
          <div class="editor-bar">
            <span class="path" id="ed-file">—</span>
            <span class="flag" id="ed-hint"></span>
          </div>
          <div id="editor"></div>
          <div class="editor-foot">
            <span id="ed-foot">— NORMAL —</span>
            <span id="ed-save"></span>
          </div>
        </div>
      </div>

      <p class="hint">
      <span><kbd>tab</kbd> complete</span>
      <span><kbd>↑</kbd> history</span>
      <span><kbd>ctrl-l</kbd> clear</span>
      <span><code>help</code> commands</span>
      <a href="/lab/read/">plain reading →</a>
      </p>

      <div class="scroll-cue"><a href="#reading">↓ reading — {posts.length} files</a></div>
    </main>

    <section class="reading" id="reading" aria-labelledby="reading-title">
      <div class="section-title">
        <span id="reading-title">reading · {posts.length} files</span>
        <a href="/lab/read/">the plain index →</a>
      </div>
      {
        yearGroups.map((group) => (
          <>
            <h2 class="year">{group.year}</h2>
            {group.posts.map((post) => (
              <a class="row" href={`/lab/read/${post.slug}/`}>
                <span class="date">{post.day}</span>
                <span class="row-main">
                  <span class="title">{post.title}</span>
                  <span class="meta">
                    {post.tags.length ? `${post.tags.join(' · ')} · ` : ''}
                    {post.minutes} min read
                  </span>
                  {post.description && <span class="desc">{post.description}</span>}
                </span>
              </a>
            ))}
          </>
        ))
      }
    </section>

    <script is:inline type="application/json" id="post-data" set:html={data}></script>

    <script>
      import { Terminal } from '@xterm/xterm';
      import { FitAddon } from '@xterm/addon-fit';
      import '@xterm/xterm/css/xterm.css';
      import { EditorView, keymap } from '@codemirror/view';
      import { EditorState } from '@codemirror/state';
      import { basicSetup } from 'codemirror';
      import { markdown } from '@codemirror/lang-markdown';
      import { oneDark } from '@codemirror/theme-one-dark';
      import { vim, Vim } from '@replit/codemirror-vim';
      import { createShell, type PostSeed, type Effect } from '../lib/terminal';
      import { pageColors, parseConfig, xtermTheme } from '../lib/terminal/theme';
      import { fg, style } from '../lib/terminal/format';

      const CONFIG_PATH = '/home/dandrok/.config/site.conf';
      const MOTD_PATH = '/etc/motd';

      const posts: PostSeed[] = JSON.parse(document.getElementById('post-data')?.textContent ?? '[]');

      const storage = (() => {
        try {
          localStorage.setItem('dotfile.probe', '1');
          localStorage.removeItem('dotfile.probe');
          return localStorage;
        } catch {
          return null;
        }
      })();

      const shell = createShell({ posts, storage });
      const term = new Terminal({
        convertEol: true,
        cursorBlink: true,
        cursorStyle: 'bar',
        fontSize: 14,
        lineHeight: 1.3,
        letterSpacing: 0.2,
        scrollback: 5000,
        fontFamily: "ui-monospace, 'JetBrains Mono', Menlo, monospace",
        allowProposedApi: true,
        theme: xtermTheme('matrix'),
      });
      const fit = new FitAddon();
      term.loadAddon(fit);
      term.open(document.getElementById('term')!);
      fit.fit();
      term.focus();

      // ---------------------------------------------------------------- theme

      function applyTheme(configText: string) {
        const config = parseConfig(configText);
        shell.env.PROMPT = config.prompt;
        const colors = pageColors(config.theme);
        const root = document.documentElement.style;
        root.setProperty('--bg', colors.bg);
        root.setProperty('--frame', colors.frame);
        root.setProperty('--text', colors.text);
        root.setProperty('--dim', colors.dim);
        root.setProperty('--accent', xtermTheme(config.theme).cursor);
        document.body.dataset.scanlines = config.scanlines ? 'on' : 'off';
        term.options.theme = xtermTheme(config.theme);
        term.options.cursorStyle = config.cursor;
        term.options.fontFamily =
          config.font === 'vt323'
            ? "'VT323', ui-monospace, monospace"
            : "ui-monospace, 'JetBrains Mono', Menlo, monospace";
        term.options.fontSize = config.font === 'vt323' ? 18 : 14;
        fit.fit();
        term.refresh(0, term.rows - 1);
      }

      // ------------------------------------------------------------------ io

      const write = (text: string) => term.write(text.replace(/\n/g, '\r\n'));


      // --------------------------------------------------------------- effects

      let editingPath: string | null = null;
      let view: EditorView | null = null;

      function handleEffect(effect: Effect) {
        switch (effect.type) {
          case 'clear':
            term.write('\x1b[2J\x1b[H');
            break;
          case 'navigate':
            setTimeout(() => {
              if (effect.url.startsWith('http') || effect.url.startsWith('mailto:')) window.open(effect.url, '_blank', 'noopener');
              else window.location.href = effect.url;
            }, 320);
            break;
          case 'edit':
            openEditor(effect.path, effect.editor);
            break;
          case 'theme':
            applyTheme(effect.config);
            break;
          case 'reset':
            applyTheme(shell.fs.read(CONFIG_PATH) ?? '');
            break;
          case 'exit':
            sessionEnded = true;
            write(fg.dim('\nlogout\n[session closed — reload the page to start again]\n'));
            break;
          case 'title':
            break;
        }
      }

      function submit(line: string) {
        const result = shell.exec(line);
        if (result.out) write(result.out.endsWith('\n') ? result.out : result.out + '\n');
        if (result.err) write(fg.error(result.err) + '\n');
        for (const effect of result.effects) handleEffect(effect);
      }

      // ---------------------------------------------------------------- editor

      function openEditor(path: string, editor: 'vim' | 'nano') {
        const content = shell.fs.read(path);
        if (content === undefined) {
          write(fg.error(`cannot open ${path}\n`));
          return;
        }
        editingPath = path;
        const layer = document.getElementById('editor-layer')!;
        const file = document.getElementById('ed-file')!;
        const foot = document.getElementById('ed-foot')!;
        const saveFlag = document.getElementById('ed-save')!;
        const hint = document.getElementById('ed-hint')!;
        layer.classList.add('on');
        layer.setAttribute('aria-hidden', 'false');
        file.textContent = path.replace('/home/dandrok', '~');
        hint.textContent = editor === 'vim' ? ':w write · :q quit · :wq both' : '^O write · ^X exit';
        foot.textContent = editor === 'vim' ? 'vim — :w write · :q quit' : 'nano — arrows, no modes';
        saveFlag.textContent = '';

        const save = () => {
          if (!view || !editingPath) return;
          const text = view.state.doc.toString();
          const written = shell.fs.writeFile(editingPath, text);
          const lines = text.split('\n').length;
          saveFlag.textContent = written.ok ? `${lines}L written` : (written.error ?? 'write failed');
          setTimeout(() => (saveFlag.textContent = ''), 2000);
          if (editingPath === CONFIG_PATH) applyTheme(text);
        };

        const close = () => {
          layer.classList.remove('on');
          layer.setAttribute('aria-hidden', 'true');
          view?.destroy();
          view = null;
          editingPath = null;
          term.focus();
          fit.fit();
          renderPrompt();
        };

        const extensions = [
          basicSetup,
          markdown(),
          oneDark,
          EditorView.theme({
            '&': { backgroundColor: 'transparent', color: 'var(--text)' },
            '.cm-content': { caretColor: 'var(--accent)' },
            '.cm-cursor, .cm-dropCursor': { borderLeftColor: 'var(--accent)' },
            '&.cm-focused .cm-selectionBackground, .cm-selectionBackground': {
              backgroundColor: 'color-mix(in srgb, var(--accent) 22%, transparent)',
            },
          }),
        ];

        if (editor === 'vim') {
          extensions.push(
            vim({ status: true }),
            EditorView.updateListener.of((update) => {
              if (update.docChanged) saveFlag.textContent = 'modified';
            }),
          );
          Vim.defineEx('write', 'w', () => save());
          Vim.defineEx('wq', 'wq', () => {
            save();
            close();
          });
          Vim.defineEx('quit', 'q', () => close());
          Vim.defineEx('q!', 'q!', () => close());
          Vim.defineEx('w!', 'w!', () => save());
        } else {
          extensions.push(
            keymap.of([
              { key: 'Ctrl-o', run: () => (save(), true) },
              { key: 'Ctrl-x', run: () => (close(), true) },
              { key: 'Escape', run: () => (close(), true) },
            ]),
          );
        }

        view = new EditorView({
          state: EditorState.create({ doc: content, extensions }),
          parent: document.getElementById('editor')!,
        });
        view.focus();
      }

      // ------------------------------------------------------------- key input
      // One line editor owns the prompt: prompt + typed text are always
      // redrawn as a single block, so backspace, arrows, tab completion and
      // history cannot leave stray prompts or half-erased characters behind.

      let input = '';
      let caret = 0;
      /** Rows the prompt+input block occupies right now (0 = single row). */
      let blockRows = 0;
      let historyIndex = -1;
      let sessionEnded = false;

      function syncTitle() {
        const el = document.getElementById('win-title');
        if (el) el.textContent = `${shell.env.USER}@${shell.env.HOST ?? 'dotfile'}: ${shell.promptPath()}`;
      }

      /** Draw prompt + input at the current position and remember its height. */
      function drawBlock() {
        const prompt = shell.prompt();
        write(fg.green(prompt));
        if (input) term.write(input);
        blockRows = Math.floor((prompt.length + input.length) / term.cols);
      }

      /** Repaint the block in place and put the caret back inside it. */
      function repaint() {
        if (blockRows > 0) term.write(`\x1b[${blockRows}A`);
        term.write('\r\x1b[J');
        drawBlock();
        const absolute = shell.prompt().length + caret;
        const caretRow = Math.floor(absolute / term.cols);
        const column = absolute % term.cols;
        const back = blockRows - caretRow;
        if (back > 0) term.write(`\x1b[${back}A`);
        term.write('\r');
        if (column > 0) term.write(`\x1b[${column}C`);
      }

      /** Fresh prompt with an empty line. */
      function renderPrompt() {
        syncTitle();
        input = '';
        caret = 0;
        blockRows = 0;
        if (!sessionEnded) write(fg.green(shell.prompt()));
      }

      function setInput(next: string, nextCaret = next.length) {
        input = next;
        caret = Math.max(0, Math.min(nextCaret, next.length));
        repaint();
      }

      function insert(text: string) {
        const clean = text.replace(/[\r\n]+/g, ' ');
        if (!clean) return;
        const atEnd = caret === input.length;
        input = input.slice(0, caret) + clean + input.slice(caret);
        caret += clean.length;
        if (atEnd) {
          // fast path: a plain append, xterm handles the wrapping itself
          term.write(clean);
          blockRows = Math.floor((shell.prompt().length + input.length) / term.cols);
        } else {
          repaint();
        }
      }

      /** Run a line as if it had been typed — the starter chips use this. */
      function runLine(line: string) {
        input = '';
        caret = 0;
        write(line + '\n');
        submit(line);
        renderPrompt();
      }

      /** What a stranger gets when they press Enter on an empty prompt. */
      function starterMenu(): string {
        const rows: [string, string][] = [
          ['read the posts', 'scroll down, or /lab/read/'],
          ['ls ~/writing', 'the articles as files'],
          ['cat about.md', 'who writes this'],
          ['help', 'every command'],
          ['theme set theme=amber', 'if green is not your thing'],
        ];
        return (
          '\n' +
          fg.dim('not sure what to type? these all work:\n') +
          rows.map(([command, what]) => `  ${fg.green(command.padEnd(24))}${fg.dim(what)}`).join('\n') +
          '\n' +
          fg.dim('or click one of the buttons under the window\n')
        );
      }

      function submitLine() {
        const line = input;
        term.write('\n');
        input = '';
        caret = 0;
        blockRows = 0;
        historyIndex = -1;
        if (line.trim()) submit(line);
        else write(starterMenu());
        renderPrompt();
      }

      function historyStep(direction: -1 | 1) {
        const entries = shell.history;
        if (!entries.length) return;
        if (historyIndex === -1) historyIndex = entries.length;
        historyIndex = Math.max(0, Math.min(entries.length, historyIndex + direction));
        const next = historyIndex >= entries.length ? '' : entries[historyIndex];
        setInput(next);
      }

      function completeInput() {
        const hits = shell.complete(input);
        const parts = input.split(/(\s+)/);
        const lastIndex = parts.length - 1;
        if (hits.length === 1) {
          parts[lastIndex] = hits[0];
          setInput(parts.join('') + (hits[0].endsWith('/') ? '' : ' '));
          return;
        }
        if (hits.length > 1) {
          write('\n' + hits.join('  ') + '\n');
          blockRows = 0;
          drawBlock();
        }
      }

      let interacted = false;

      function handleData(data: string) {
        if (sessionEnded) return;
        interacted = true;
        if (view && !term.element?.classList.contains('focus')) return;

        if (data === '\r' || data === '\n') {
          submitLine();
          return;
        }
        if (data === '\x7f' || data === '\x08') {
          if (caret > 0) setInput(input.slice(0, caret - 1) + input.slice(caret), caret - 1);
          return;
        }
        if (data === '\x1b[3~') {
          if (caret < input.length) setInput(input.slice(0, caret) + input.slice(caret + 1), caret);
          return;
        }
        if (data === '\t') {
          completeInput();
          return;
        }
        if (data === '\x03') {
          term.write('^C\n');
          input = '';
          caret = 0;
          blockRows = 0;
          renderPrompt();
          return;
        }
        if (data === '\x0c') {
          term.write('\x1b[2J\x1b[H');
          blockRows = 0;
          drawBlock();
          return;
        }
        if (data === '\x01') {
          setInput(input, 0);
          return;
        }
        if (data === '\x05') {
          setInput(input, input.length);
          return;
        }
        if (data === '\x04') {
          if (!input) write(fg.dim('\n[use `exit` to leave]\n'));
          return;
        }
        if (data === '\x1b[A') {
          historyStep(-1);
          return;
        }
        if (data === '\x1b[B') {
          historyStep(1);
          return;
        }
        if (data === '\x1b[D' || data === '\x1b[H') {
          if (caret > 0) setInput(input, caret - 1);
          return;
        }
        if (data === '\x1b[C' || data === '\x1b[F') {
          if (caret < input.length) setInput(input, caret + 1);
          return;
        }
        // printable text, including multi-character pastes
        if (data >= ' ' || /[^\x00-\x1f]/.test(data)) insert(data);
      }

      term.onData(handleData);

      addEventListener('resize', () => {
        fit.fit();
        document.getElementById('win-size')!.textContent = `${term.cols}×${term.rows}`;
      });

      // ------------------------------------------------------------------ boot

      applyTheme(shell.fs.read(CONFIG_PATH) ?? '');
      write(fg.dim(`Last login: ${new Date().toDateString()} on pts/0`) + '\n');
      const motd = shell.fs.read(MOTD_PATH);
      if (motd) write(style.bold(fg.bright(motd.replace(/\n$/, ''))) + '\n');
      write(style.bold(fg.bright('dandrok')) + fg.dim(' — frontend engineer · TypeScript, React') + '\n');
      write(
        fg.dim(`${posts.length} articles in `) +
          fg.green('~/writing') +
          fg.dim(', a shell you can actually use, and a plain reading view.') +
          '\n',
      );
      write(
        fg.dim('type ') +
          fg.green('ls') +
          fg.dim(' to look around · ') +
          fg.green('help') +
          fg.dim(' for everything · ') +
          fg.green('enter') +
          fg.dim(' on an empty line if you are stuck') +
          '\n\n',
      );

      // the window opens on content, not on an empty screen
      write(fg.dim('newest in ~/writing:\n'));
      const newest = [...posts].slice(0, 5);
      const nameWidth = 32;
      for (const post of newest) {
        const full = `${post.slug}.md`;
        const file = full.length > nameWidth - 1 ? full.slice(0, nameWidth - 2) + '…' : full;
        // narrow terminals get names only: a wrapped title reads like noise
        const label = term.cols < 70 ? fg.green(file) : fg.green(file.padEnd(nameWidth)) + fg.dim(post.title);
        write('  ' + label + '\n');
      }
      write(fg.dim('  … ') + fg.green(`${Math.max(0, posts.length - newest.length)} more`) + fg.dim(' — ') + fg.green('ls ~/writing') + '\n\n');
      renderPrompt();

      // starter chips: clicking one types the command, so the metaphor lands
      const suggestBar = document.getElementById('suggest');
      const SUGGEST_KEY = 'dotfile.suggest.v1';
      let chipRuns = 0;
      const hideSuggest = () => {
        if (suggestBar) suggestBar.hidden = true;
        storage?.setItem(SUGGEST_KEY, 'hidden');
      };
      if (suggestBar) {
        if (storage?.getItem(SUGGEST_KEY) === 'hidden') suggestBar.hidden = true;
        suggestBar.querySelectorAll('[data-run]').forEach((chip) => {
          chip.addEventListener('click', () => {
            runLine((chip as HTMLElement).dataset.run ?? '');
            term.focus();
            chipRuns += 1;
            if (chipRuns >= 2) hideSuggest();
          });
        });
        document.getElementById('suggest-hide')?.addEventListener('click', hideSuggest);
      }

      // a nudge for anyone who lands and freezes
      setTimeout(() => {
        if (!interacted && !sessionEnded) {
          write(
            '\n' +
              fg.dim('  tip: ') +
              fg.green('ls') +
              fg.dim(' looks around · ') +
              fg.green('help') +
              fg.dim(' lists commands · the buttons below do it for you\n'),
          );
          renderPrompt();
        }
      }, 9000);
      document.getElementById('win-size')!.textContent = `${term.cols}×${term.rows}`;

      // hooks used by the test harness and by `?cmd=` deep links
      (window as unknown as { dotfile: unknown }).dotfile = {
        shell,
        term,
        run: (line: string) => runLine(line),
        key: (data: string) => handleData(data),
        input: () => input,
        caret: () => caret,
        editorDoc: () => view?.state.doc.toString() ?? null,
        editorOpen: () => view !== null,
        applyTheme,
        closeEditor: () => document.getElementById('editor-layer')?.classList.remove('on'),
      };

      const params = new URLSearchParams(location.search);
      const scripted = params.getAll('cmd');
      if (scripted.length) {
        for (const line of scripted) {
          write(line + '\n');
          submit(line);
        }
        renderPrompt();
      }
    </script>
  </body>
</html>
